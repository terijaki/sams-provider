  },
  "scripts": {
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vite-plus": "0.2.1"
  },
  "peerDependencies": {
    "typescript": ">=5.5 || >=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "bun@1.4.0"
}
