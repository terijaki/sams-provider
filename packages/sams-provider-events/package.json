{
  "name": "sams-provider-events",
  "version": "0.2.0",
  "description": "Types, Zod schemas, and constants for SAMS provider events delivered to consumer SQS queues.",
  "keywords": [
    "SAMS",
    "events",
    "sqs",
    "volleyball"
  ],
  "homepage": "https://github.com/terijaki/sams-provider#readme",
  "bugs": {
    "url": "https://github.com/terijaki/sams-provider/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Björn Kohnen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terijaki/sams-provider.git",
    "directory": "packages/sams-provider-events"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
